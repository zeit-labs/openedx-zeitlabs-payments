#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:52
msgid "Apply"
msgstr "تطبيق"

#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:60
msgid "Total:"
msgstr "المجموع:"

#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:85
msgid "Note:"
msgstr "ملاحظة:"

#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:85
msgid "Earn a valuable certificate to showcase the skills you learn in"
msgstr "احصل على شهادة قيّمة لإبراز المهارات التي تعلمتها"

#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:91
msgid "Have questions?"
msgstr "هل لديك أسئلة؟"

#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:92
msgid "Please read our FAQs to view common questions about our certificates."
msgstr "يرجى قراءة الأسئلة الشائعة للاطلاع على الأسئلة المتداولة حول شهاداتنا."

#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:97
msgid "No cart exist."
msgstr "لا يوجد سلة."

#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:98
msgid "If you need assistance, contact dev support."
msgstr "إذا كنت بحاجة إلى مساعدة، تواصل مع الدعم الفني."

#: zeitlabs_payments/templates/zeitlabs_payments/payment_successful.html:33
msgid "Your payment was successful and enrollment is updated."
msgstr "تمت عملية الدفع بنجاح وتم تحديث التسجيل."

#: zeitlabs_payments/templates/zeitlabs_payments/payment_successful.html:34
msgid "Thank you for your purchase!"
msgstr "شكراً لك على الشراء!"

#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:38
msgid "Something went wrong while fullfilling Payment"
msgstr "حدث خطأ أثناء إتمام عملية الدفع"

#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:39
msgid "We couldn't process your transaction completely at this time."
msgstr "لم نتمكن من إتمام معاملتك في الوقت الحالي."

#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:42-44
#, python-format
msgid "Your reference number is: %(ref)s"
msgstr "رقم المرجع الخاص بك هو: %(ref)s"

#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:48
msgid "Contact us for further support."
msgstr "تواصل معنا للحصول على مزيد من الدعم."

#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:49
msgid "Contact Support"
msgstr "تواصل مع الدعم"

#: zeitlabs_payments/templates/zeitlabs_payments/payment_pending.html:32
msgid "Payment confirmation not received yet. If payment was successful and you're still seeing this message, please wait for a while. If your enrollment doesn't update after that, kindly contact us."
msgstr "لم يتم استلام تأكيد الدفع بعد. إذا كانت عملية الدفع ناجحة وما زلت ترى هذه الرسالة، يرجى الانتظار لبعض الوقت. إذا لم يتم تحديث تسجيلك بعد ذلك، يرجى التواصل معنا."

#: zeitlabs_payments/templates/zeitlabs_payments/payment_decline.html:40
msgid "Payment Declined"
msgstr "تم رفض الدفع"

#: zeitlabs_payments/templates/zeitlabs_payments/payment_decline.html:42
msgid "Your payment was declined by the payment provider and could not be completed."
msgstr "تم رفض عملية الدفع من قبل مزود خدمة الدفع ولم يتم إتمامها."

#: zeitlabs_payments/templates/zeitlabs_payments/payment_decline.html:52
msgid "Please try again or use a different payment method."
msgstr "يرجى المحاولة مرة أخرى أو استخدام طريقة دفع مختلفة."

