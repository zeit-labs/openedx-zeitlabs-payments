#: templates/zeitlabs_payments/admin/accept_payment.html:24
#, python-format
msgid "Payment %(reference)s: %(amount)s %(currency)s, %(status)s. %(reason)s"
msgstr ""
"عملية الدفع %(reference)s: %(amount)s %(currency)s، %(status)s. %(reason)s"

#: templates/zeitlabs_payments/admin/accept_payment.html:28
msgid ""
"No payment was recorded for this cart: the gateway's answer could not be "
"read or recorded."
msgstr ""
"لم تُسجَّل أي عملية دفع لسلة التسوق هذه: تعذّرت قراءة رد البوابة أو تسجيله."

#: templates/zeitlabs_payments/admin/accept_payment.html:32
msgid "Why the gateway's answers were not settled"
msgstr "سبب عدم تسوية ردود البوابة"

#: templates/zeitlabs_payments/admin/accept_payment.html:46
msgid "Accept the payment"
msgstr "قبول عملية الدفع"

#: templates/zeitlabs_payments/admin/accept_payment.html:47
