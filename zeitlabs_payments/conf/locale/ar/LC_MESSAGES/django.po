#. checkout.html - Voucher section
#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:56
msgid "Have a coupon code?"
msgstr "هل لديك رمز قسيمة؟"

#. checkout.html - Voucher placeholder
#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:60
msgid "Enter coupon code"
msgstr "أدخل رمز القسيمة"

#. checkout.html - Apply button
#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:62
msgid "Apply"
msgstr "تطبيق"

#. checkout.html - Subtotal
#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:70
#: zeitlabs_payments/templates/zeitlabs_payments/invoice.html:109
