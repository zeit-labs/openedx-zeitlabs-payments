msgstr "المجموع الكلي"

#. checkout.html - Help section
#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:97
msgid "Have questions?"
msgstr "هل لديك أسئلة؟"

#. checkout.html - Help link
#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:98
msgid "Please read our FAQs to view common questions about our certificates."
msgstr "يرجى قراءة الأسئلة الشائعة لعرض الأسئلة المتكررة حول شهاداتنا."

#. checkout.html - Empty cart title
#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:111
msgid "No cart exists"
msgstr "لا توجد سلة تسوق"

#. checkout.html - Empty cart message
#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:112
msgid "Your shopping cart is empty. Please add items to continue."
msgstr "سلة التسوق فارغة. يرجى إضافة عناصر للمتابعة."

#. checkout.html - Browse courses button
#: zeitlabs_payments/templates/zeitlabs_payments/checkout.html:114
msgid "Browse Courses"
msgstr "تصفح الدورات"

#. wait_feedback.html - Processing title
#: zeitlabs_payments/templates/zeitlabs_payments/wait_feedback.html:12
msgid "Processing Your Payment..."
msgstr "جارٍ معالجة الدفع..."

#. wait_feedback.html - Processing message
#: zeitlabs_payments/templates/zeitlabs_payments/wait_feedback.html:14
msgid "Please wait while we confirm your payment. This may take a few moments."
msgstr "يرجى الانتظار بينما نقوم بتأكيد الدفع. قد يستغرق هذا بضع لحظات."

#. wait_feedback.html - Transaction ID label
#: zeitlabs_payments/templates/zeitlabs_payments/wait_feedback.html:17
msgid "Transaction ID:"
msgstr "رقم المعاملة:"

#. wait_feedback.html - Warning message
#: zeitlabs_payments/templates/zeitlabs_payments/wait_feedback.html:20
msgid "Please do not close this page or press the back button."
msgstr "يرجى عدم إغلاق هذه الصفحة أو الضغط على زر الرجوع."

#. wait_feedback.html - Payment confirmed (JavaScript)
#: zeitlabs_payments/templates/zeitlabs_payments/wait_feedback.html:53
msgid "Payment Confirmed! Redirecting..."
msgstr "تم تأكيد الدفع! جارٍ التحويل..."

#. wait_feedback.html - Progress step 1
#: zeitlabs_payments/templates/zeitlabs_payments/wait_feedback.html:40
msgid "Payment Submitted"
msgstr "تم إرسال الدفع"

#. wait_feedback.html - Progress step 2
#: zeitlabs_payments/templates/zeitlabs_payments/wait_feedback.html:49
msgid "Verifying Payment"
msgstr "جارٍ التحقق من الدفع"

#. wait_feedback.html - Progress step 3
#: zeitlabs_payments/templates/zeitlabs_payments/wait_feedback.html:58
msgid "Completing Order"
msgstr "جارٍ إتمام الطلب"

#. payment_decline.html - Title
#: zeitlabs_payments/templates/zeitlabs_payments/payment_decline.html:18
msgid "Payment Declined"
msgstr "تم رفض الدفع"

#. payment_decline.html - Message
#: zeitlabs_payments/templates/zeitlabs_payments/payment_decline.html:20
msgid "Your payment was declined by the payment provider and could not be completed."
msgstr "تم رفض الدفع من قبل مزود خدمة الدفع ولم يتم إكماله."

#. payment_decline.html, payment_error.html - Reference label
#: zeitlabs_payments/templates/zeitlabs_payments/payment_decline.html:24
#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:27
msgid "Reference:"
msgstr "المرجع:"

#. payment_decline.html - Try again message
#: zeitlabs_payments/templates/zeitlabs_payments/payment_decline.html:28
msgid "Please try again or use a different payment method."
msgstr "يرجى المحاولة مرة أخرى أو استخدام طريقة دفع مختلفة."

#. Common - Try Again button
#: zeitlabs_payments/templates/zeitlabs_payments/payment_decline.html:32
#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:38
msgid "Try Again"
msgstr "حاول مرة أخرى"

#. Common - Contact Support button
#: zeitlabs_payments/templates/zeitlabs_payments/payment_decline.html:35
#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:35
#: zeitlabs_payments/templates/zeitlabs_payments/payment_pending.html:30
msgid "Contact Support"
msgstr "تواصل مع الدعم"

#. payment_error.html - Title
#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:18
msgid "Payment Error"
msgstr "خطأ في الدفع"

#. payment_error.html - Message 1
#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:20
msgid "Something went wrong while processing your payment."
msgstr "حدث خطأ أثناء معالجة الدفع."

#. payment_error.html - Message 2
#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:23
msgid "We couldn't process your transaction completely at this time."
msgstr "لم نتمكن من إكمال معاملتك في الوقت الحالي."

#. payment_error.html - Contact message
#: zeitlabs_payments/templates/zeitlabs_payments/payment_error.html:31
msgid "Please contact us for further support."
msgstr "يرجى التواصل معنا للحصول على مزيد من الدعم."

#. payment_pending.html - Title
#: zeitlabs_payments/templates/zeitlabs_payments/payment_pending.html:18
msgid "Payment Pending"
msgstr "الدفع قيد الانتظار"

#. payment_pending.html - Message 1
#: zeitlabs_payments/templates/zeitlabs_payments/payment_pending.html:20
msgid "Payment confirmation not received yet."
msgstr "لم يتم استلام تأكيد الدفع بعد."

#. payment_pending.html - Message 2
#: zeitlabs_payments/templates/zeitlabs_payments/payment_pending.html:23
msgid "If payment was successful and you're still seeing this message, please wait for a while. If your enrollment doesn't update after that, kindly contact us."
msgstr "إذا تم الدفع بنجاح وما زلت ترى هذه الرسالة، يرجى الانتظار قليلاً. إذا لم يتم تحديث تسجيلك بعد ذلك، يرجى التواصل معنا."

#. Common - Go to Dashboard button
#: zeitlabs_payments/templates/zeitlabs_payments/payment_pending.html:27
#: zeitlabs_payments/templates/zeitlabs_payments/payment_successful.html:26
msgid "Go to Dashboard"
msgstr "الذهاب إلى لوحة التحكم"

#. payment_successful.html - Title
#: zeitlabs_payments/templates/zeitlabs_payments/payment_successful.html:17
msgid "Payment Successful!"
msgstr "تم الدفع بنجاح!"

#. payment_successful.html - Message 1
#: zeitlabs_payments/templates/zeitlabs_payments/payment_successful.html:19
msgid "Your payment was successful and your enrollment has been updated."
msgstr "تم الدفع بنجاح وتم تحديث تسجيلك."

#. payment_successful.html - Thank you message
#: zeitlabs_payments/templates/zeitlabs_payments/payment_successful.html:22
msgid "Thank you for your purchase!"
msgstr "شكراً لك على الشراء!"

#. payment_successful.html - Browse more button
#: zeitlabs_payments/templates/zeitlabs_payments/payment_successful.html:29
msgid "Browse More Courses"
msgstr "تصفح المزيد من الدورات"

