#: templates/zeitlabs_payments/manual_payment_confirm.html:98
msgid "Confirm Your Payment"
msgstr "تأكيد الدفع الخاص بك"

#: templates/zeitlabs_payments/manual_payment_confirm.html:99
msgid "Please review your order details below and confirm your payment."
msgstr "يرجى مراجعة تفاصيل طلبك أدناه وتأكيد الدفع."

#: templates/zeitlabs_payments/manual_payment_confirm.html:116
msgid "Cancel"
msgstr "إلغاء"

#: templates/zeitlabs_payments/manual_payment_confirm.html:119
msgid "Confirm Payment"
msgstr "تأكيد الدفع"

#: templates/zeitlabs_payments/payment_decline.html:18
msgid "Payment Declined"
msgstr "تم رفض الدفع"

#: templates/zeitlabs_payments/payment_decline.html:20
msgid ""
"Your payment was declined by the payment provider and could not be completed."
msgstr "تم رفض الدفع من قبل مزود خدمة الدفع ولم يتم إكماله."

#: templates/zeitlabs_payments/payment_decline.html:24
#: templates/zeitlabs_payments/payment_error.html:27
msgid "Reference:"
msgstr "المرجع:"

#: templates/zeitlabs_payments/payment_decline.html:28
msgid "Please try again or use a different payment method."
msgstr "يرجى المحاولة مرة أخرى أو استخدام طريقة دفع مختلفة."

#: templates/zeitlabs_payments/payment_decline.html:32
#: templates/zeitlabs_payments/payment_error.html:42
msgid "Try Again"
msgstr "حاول مرة أخرى"

#: templates/zeitlabs_payments/payment_error.html:18
msgid "Payment Error"
msgstr "خطأ في الدفع"

#: templates/zeitlabs_payments/payment_error.html:20
msgid "Something went wrong while processing your payment."
msgstr "حدث خطأ أثناء معالجة الدفع."

#: templates/zeitlabs_payments/payment_error.html:23
msgid "We couldn't process your transaction completely at this time."
msgstr "لم نتمكن من إكمال معاملتك في الوقت الحالي."

#: templates/zeitlabs_payments/payment_error.html:32
msgid "Please contact us for further support."
msgstr "يرجى التواصل معنا للحصول على مزيد من الدعم."

#: templates/zeitlabs_payments/payment_pending.html:20
msgid "Payment confirmation not received yet."
msgstr "لم يتم استلام تأكيد الدفع بعد."

#: templates/zeitlabs_payments/payment_pending.html:23
msgid ""
"If payment was successful and you're still seeing this message, please wait "
"for a while. If your enrollment doesn't update after that, kindly contact us."
msgstr ""
"إذا تم الدفع بنجاح وما زلت ترى هذه الرسالة، يرجى الانتظار قليلاً. إذا لم يتم "
"تحديث تسجيلك بعد ذلك، يرجى التواصل معنا."

#: templates/zeitlabs_payments/payment_pending.html:27
msgid "Go to Dashboard"
msgstr "الذهاب إلى لوحة التحكم"

#: templates/zeitlabs_payments/payment_successful.html:17
msgid "Payment Successful!"
msgstr "تم الدفع بنجاح!"

#: templates/zeitlabs_payments/payment_successful.html:19
msgid "Your payment was successful and your enrollment has been updated."
msgstr "تم الدفع بنجاح وتم تحديث تسجيلك."

#: templates/zeitlabs_payments/payment_successful.html:22
msgid "Thank you for your purchase!"
msgstr "شكراً لك على الشراء!"

#: templates/zeitlabs_payments/payment_successful.html:26
msgid "View Your Courses"
msgstr "عرض دوراتك"

#: templates/zeitlabs_payments/payment_successful.html:29
msgid "Browse More Courses"
msgstr "تصفح المزيد من الدورات"

#: templates/zeitlabs_payments/wait_feedback.html:27
msgid "Processing Your Payment..."
msgstr "جارٍ معالجة الدفع..."

#: templates/zeitlabs_payments/wait_feedback.html:30
msgid "Please wait while we confirm your payment. This may take a few moments."
msgstr "يرجى الانتظار بينما نقوم بتأكيد الدفع. قد يستغرق هذا بضع لحظات."

#: templates/zeitlabs_payments/wait_feedback.html:42
msgid "Payment Submitted"
msgstr "تم إرسال الدفع"

#: templates/zeitlabs_payments/wait_feedback.html:51
msgid "Verifying Payment"
msgstr "جارٍ التحقق من الدفع"

#: templates/zeitlabs_payments/wait_feedback.html:60
msgid "Completing Order"
msgstr "جارٍ إتمام الطلب"

#: templates/zeitlabs_payments/wait_feedback.html:65
msgid "Transaction ID:"
msgstr "رقم المعاملة:"

#: templates/zeitlabs_payments/wait_feedback.html:75
msgid "Please do not close this page or press the back button."
msgstr "يرجى عدم إغلاق هذه الصفحة أو الضغط على زر الرجوع."

#: templates/zeitlabs_payments/wait_feedback.html:354
msgid "Payment Confirmed! Redirecting..."
msgstr "تم تأكيد الدفع! جارٍ التحويل..."
